{
  "name": "chord-lab-studio",
  "version": "1.7.0",
  "private": true,
  "description": "Chord Lab Studio: κύκλος πέμπτων, τρεις προτάσεις από το ύφος σου, μπάρα σύνθεσης με διάρκειες. Offline.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-v16.cjs",
    "build:mac": "electron-builder --mac dmg zip --arm64",
    "build:win": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.chordlab.harmonicuniverse",
    "productName": "Chord Lab Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "legacy/**/*",
      "assets/**/*",
      "desktop/*.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "artifactName": "Chord-Lab-Studio-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "productName": "Chord Lab Studio"
}
